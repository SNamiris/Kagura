{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propbox.local/schemas/aliases.schema.json",
  "title": "别名表",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "enum": [
        "author",
        "song",
        "composer"
      ]
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    }
  }
}
